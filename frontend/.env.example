# Frontend configuration template. Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Vite inlines VITE_* variables at BUILD time. A production bundle carries
# whatever value was set when it was built — there is no runtime override.

# Base URL of the backend API. No trailing slash (one is stripped anyway).
#
#   local development : http://localhost:8000
#   production        : https://api.example.edu
#
# Local development falls back to http://localhost:8000 when this is unset.
# A PRODUCTION BUILD DOES NOT FALL BACK: `npm run build` aborts before producing
# a bundle if this is missing, rather than silently shipping localhost.
#
#   VITE_API_BASE_URL=https://api.example.edu npm run build
VITE_API_BASE_URL=http://localhost:8000
