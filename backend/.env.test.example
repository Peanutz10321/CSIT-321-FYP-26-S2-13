# Test configuration template. Copy to .env.test:
#   cp .env.test.example .env.test
#
# Values here are throwaway by design — the test suite must never point at a
# real database or reuse a deployment secret.

# Keep this SQLite. conftest.py refuses any other backend unless the target is
# named explicitly in ALLOWED_TEST_DATABASES, because the per-test cleanup
# deletes rows.
DATABASE_URL=sqlite:///./test.db

JWT_SECRET=test-jwt-secret
JWT_ALGORITHM=HS256
TESTING=true

# Throwaway Fernet key — TEST-ONLY, safe to commit and shared with CI. It is not
# a real deployment secret and differs from JWT_SECRET and RECEIPT_SIGNING_SECRET
# above. Generate your own if you prefer:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEYSTORE_MASTER_SECRET=odLNbv3Y2g1epq7Q-qRgM2riovLBiRnrp7KAEGjKujs=

# Must be at least 32 bytes and different from the two secrets above.
RECEIPT_SIGNING_SECRET=test-receipt-signing-secret-not-real

# Throwaway PostgreSQL for the migration, race, audit-privilege and seed tests.
#
# DELIBERATELY LEFT COMMENTED OUT. While TEST_POSTGRES_URL is unset, the five
# tests/*_postgres.py files skip themselves, so the documented safe run
#
#   pytest tests -q
#
# needs no PostgreSQL at all and cannot touch a real database. Uncommenting this
# without also arming ALLOW_DESTRUCTIVE_DB_TESTS does not make those tests run —
# it makes them ERROR, because the destructive guard refuses them.
#
# Prefer exporting it per command instead of uncommenting it here, so the safe
# run stays safe by default. First start the disposable container:
#
#   docker run --rm -d -p 55432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=evoting_test \
#     --name evoting-test-pg postgres:16
#
# The destructive guard additionally requires the database to be named exactly
# evoting_test on a local host. This is NOT your development database — the
# fixtures drop and recreate the public schema.
#
# TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:55432/evoting_test

# ALLOW_DESTRUCTIVE_DB_TESTS is deliberately NOT set here. It arms
# DROP SCHEMA public CASCADE, so it is passed per command instead:
#   ALLOW_DESTRUCTIVE_DB_TESTS=true pytest tests -q
