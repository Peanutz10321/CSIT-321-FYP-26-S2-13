# Production dependencies — direct requirements only.
#
# This file is the source of truth. requirements.txt is GENERATED from it and
# must not be edited by hand:
#
#     pip-compile requirements.in
#
# See DEPENDENCIES.md for the full regeneration and audit procedure.

fastapi
uvicorn

# Database and migrations
sqlalchemy
alembic
psycopg2-binary

# Configuration
python-dotenv
pydantic-settings
pydantic[email]

# Authentication and password hashing.
# bcrypt is pinned below 4.1 because passlib 1.7.x reads bcrypt.__about__,
# which was removed in bcrypt 4.1 — leaving it unpinned breaks login.
passlib[bcrypt]
bcrypt==4.0.1
python-jose[cryptography]

# Paillier homomorphic encryption
phe

# Fernet, used directly by app/security/keystore.py to wrap election private
# keys. Listed here even though python-jose[cryptography] above already pulls it
# in: a direct import must not depend on another package's optional extra, which
# could be dropped or renamed upstream without warning. Declaring it also makes
# the `# via` annotation in requirements.txt tell the truth.
cryptography
