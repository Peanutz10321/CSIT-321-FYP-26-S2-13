# Backend configuration template. Copy to .env and fill in real values.
#   cp .env.example .env
#
# COPYING THIS FILE IS NOT ENOUGH. The three secrets below are intentionally
# empty and DATABASE_URL is a placeholder. All four must hold real values before
# the application is usable. The first error you will see is:
#
#   ValidationError: RECEIPT_SIGNING_SECRET must be at least 32 bytes
#
# A BLANK value is refused at startup for all four, so none can be silently
# forgotten. FORMAT is a different matter:
#
#   RECEIPT_SIGNING_SECRET  blank AND length (>=32 bytes) AND distinctness from
#                           the other two secrets are all enforced
#   JWT_SECRET              blank is refused; length is NOT checked, so a short
#                           weak value is accepted — use the generator below
#   KEYSTORE_MASTER_SECRET  blank is refused; Fernet format is NOT checked at
#                           startup and still fails at election activation
#   DATABASE_URL            blank is refused indirectly, by SQLAlchemy
#
# .env is gitignored. Never commit real secrets, connection strings or
# deployment hostnames.

# --- Database -----------------------------------------------------------
# The database must already exist; the application never creates it. Use the
# direct/session connection for migrations; a transaction pooler can break DDL.
#
# Matching the development container documented in the root readme.md
# (development-only credentials — do not reuse them anywhere reachable):
#
#   DATABASE_URL=postgresql://evoting_dev:dev-only-not-a-real-password@localhost:5432/evoting
#
# This is NOT the test database. tests/*_postgres.py use a separate, disposable
# `evoting_test` database on port 55432 that is dropped and recreated.
DATABASE_URL=postgresql://user:password@localhost:5432/evoting

# --- Authentication -----------------------------------------------------
# Signs access tokens. Use an independently random value of at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unlike RECEIPT_SIGNING_SECRET, this length is NOT enforced at startup.
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Secrets ------------------------------------------------------------
# Fernet key wrapping each election's Paillier private key. This must be a real
# Fernet key — arbitrary random text is rejected.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# RETAIN THIS VALUE for as long as any existing election keys must remain usable.
# Losing or rotating it makes those private keys undecryptable, so the affected
# elections can never be tallied. Back it up alongside the database, not in it.
KEYSTORE_MASTER_SECRET=

# Keys the ballot commitment on every receipt. REQUIRED — the app refuses to
# start without it. Must be at least 32 UTF-8 bytes and must differ from both
# JWT_SECRET and KEYSTORE_MASTER_SECRET.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this invalidates every existing ballot commitment.
RECEIPT_SIGNING_SECRET=

# --- Environment and CORS ----------------------------------------------
# Allowed values: development, test, production (case and whitespace are normalized).
# Unknown values are rejected at startup; production enables stricter checks.
ENVIRONMENT=development

# Comma-separated browser origins allowed to call this API. Each entry is
# scheme://host[:port] with no trailing path.
#
#   development : http://localhost:5173
#   production  : https://vote.example.edu,https://admin.example.edu
#
# Optional for an API-only backend (Swagger UI, curl, the test suite). REQUIRED
# as soon as you use the React frontend, which calls this API from a different
# origin — without it the backend still starts and the browser silently refuses
# every request.
#
# Empty means no cross-origin access (fail closed), which is the safe default
# outside production. In production at least one HTTPS origin is REQUIRED;
# plain HTTP and the wildcard "*" are REJECTED at startup.
CORS_ALLOWED_ORIGINS=http://localhost:5173
