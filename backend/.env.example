# Backend configuration template. Copy to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets, connection strings or
# deployment hostnames.

# --- Database -----------------------------------------------------------
# Local PostgreSQL, or a hosted connection string. Use the direct/session
# connection for migrations; a transaction pooler can break DDL.
DATABASE_URL=postgresql://user:password@localhost:5432/evoting

# --- Authentication -----------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Secrets ------------------------------------------------------------
# Fernet key wrapping each election's Paillier private key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEYSTORE_MASTER_SECRET=

# Keys the ballot commitment on every receipt. REQUIRED — the app refuses to
# start without it. Must be at least 32 UTF-8 bytes and must differ from both
# JWT_SECRET and KEYSTORE_MASTER_SECRET.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this invalidates every existing ballot commitment.
RECEIPT_SIGNING_SECRET=

# --- Environment and CORS ----------------------------------------------
# Allowed values: development, test, production (case and whitespace are normalized).
# Unknown values are rejected at startup; production enables stricter checks.
ENVIRONMENT=development

# Comma-separated browser origins allowed to call this API. Each entry is
# scheme://host[:port] with no trailing path.
#
#   development : http://localhost:5173
#   production  : https://vote.example.edu,https://admin.example.edu
#
# Empty means no cross-origin access (fail closed), which is the safe default
# outside production. In production at least one HTTPS origin is REQUIRED;
# plain HTTP and the wildcard "*" are REJECTED at startup.
CORS_ALLOWED_ORIGINS=http://localhost:5173
