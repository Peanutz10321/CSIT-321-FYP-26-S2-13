# Performance-test data setup — configuration template.
#
# Variable NAMES and PLACEHOLDER values only. Never commit a filled-in copy:
# the repository .gitignore ignores performance_tests/.env* except this file.
#
# The scripts read these from the process environment, not from this file.
# See README.md for the PowerShell commands that export them.

# The staging deployment to prepare data on. Must be HTTPS, and its hostname
# must contain "staging" or "performance" — the scripts refuse anything else.
PERF_BASE_URL=https://<your-staging-host>.example.com

# The real production URL. Required in every mode, including local mode, and
# never contacted: the scripts refuse to run when this and PERF_BASE_URL resolve
# to the same target.
PERF_PRODUCTION_BASE_URL=https://<your-production-host>.example.com

# Loopback-only local testing. Must be exactly "true" or "false" (lowercase);
# "TRUE", "1", "yes" and "true " are errors, not silent "off".
#
#   unset / false -> normal rules: HTTPS + a staging/performance hostname.
#   true          -> PERF_BASE_URL must be a LOOPBACK target and nothing else:
#                    localhost, 127.0.0.0/8 or [::1], over http or https, with
#                    an explicit port. Public URLs are refused in this mode even
#                    over HTTPS, so an "armed for local" run can never quietly
#                    reach staging.
#
# Arming this does NOT arm anything else: PERF_SETUP_ALLOWED is still required
# to create accounts, and PERF_VOTE_LOAD_ALLOWED is still required to vote.
PERF_LOCAL_TEST_ALLOWED=false

# Arms the setup script. Must be exactly the lowercase string "true";
# "TRUE", "1" and "yes" are all refused. Not needed for verification.
PERF_SETUP_ALLOWED=false

# Batch identifier: 1-24 alphanumeric characters, embedded in every generated
# username and email. Defaults to a timestamp, which changes every minute —
# set it explicitly, and reuse the same value to resume an interrupted run.
PERF_BATCH=<YYYYMMDDHHMM>

# Organizer account for this batch. Both default to a value derived from
# PERF_BATCH if left unset.
PERF_ORGANIZER_EMAIL=perf_organizer_<batch>@test.com
PERF_ORGANIZER_USERNAME=perf_organizer_<batch>

# Passwords have NO defaults and must be at least 8 characters. Do not write
# real values into this file — export them in the shell instead.
PERF_ORGANIZER_PASSWORD=<set-in-your-shell-not-here>
PERF_VOTER_PASSWORD=<set-in-your-shell-not-here>

# How long the generated elections stay open, in whole hours. Default 24.
PERF_ELECTION_DURATION_HOURS=24


# ── Locust load test (performance_tests/locustfile.py) ───────────────────────
#
# The setup and verification scripts ignore everything below.

# Which scenario to run. Matched EXACTLY — "read" or "vote", no default, no
# stray whitespace, no capitals. "vote" casts permanent ballots.
PERF_SCENARIO=read

# Think time between read requests, in seconds. Defaults to a realistic 1-3.
PERF_MIN_WAIT_SECONDS=1
PERF_MAX_WAIT_SECONDS=3

# ── Vote scenario only. Both are required, and both are irreversible. ────────
#
# Each vote permanently consumes that voter's single ballot for the selected
# election. There is no unvote endpoint and no reset. Leave these unset for
# read runs.

# Arms voting. Must be exactly the lowercase string "true".
PERF_VOTE_LOAD_ALLOWED=false

# Which prepared election to vote in: 1, 2 or 3. Never defaulted.
# The cohort size is fixed by the run and --users must match exactly:
#   run 1 -> --users 10, run 2 -> --users 25, run 3 -> --users 50
PERF_VOTE_ELECTION_RUN=1

# How long a prepared voter holds at the synchronization barrier before the run
# is abandoned, in seconds. Must be a positive number. Must comfortably exceed
# the spawn time of the largest cohort: 50 voters at --spawn-rate 0.2 take about
# 250 seconds to spawn, before their logins and readiness checks.
PERF_VOTE_READY_TIMEOUT_SECONDS=600
